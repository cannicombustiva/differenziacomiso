{
  "name": "differenzia-comiso",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @differenzia/citizen dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "build": "pnpm --filter @differenzia/citizen build",
    "start": "pnpm --filter @differenzia/citizen start",
    "lint": "pnpm --filter @differenzia/citizen lint && pnpm exec eslint packages/core/src scripts",
    "prepare": "husky",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@differenzia/core": "workspace:*"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": "eslint --fix"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/node": "^20.17.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pg": "^8.18.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vercel": "^50.22.1",
    "vitest": "^4.1.9"
  }
}
